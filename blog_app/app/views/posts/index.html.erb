<h1>Posts</h1>

<%= link_to "New Post", new_post_path %>

<ul>
  <% @posts.each do |post| %>
    <li>
      <strong><%= post.title %></strong>
      by <%= post.author.name %>

      |
      <%= link_to "Show", post_path(post) %>

      |
      <%= link_to "Edit", edit_post_path(post) %>

      |
      <%= link_to "Delete", post_path(post) %>
    </li>
  <% end %>
</ul>
